# Copy to .env on Tower before `docker compose up -d`. Real .env is never
# committed — generate real secrets with:
#   openssl rand -base64 36 | tr -dc 'A-Za-z0-9'   (MEILI_MASTER_KEY)
#   openssl rand -base64 36                          (NEXTAUTH_SECRET)
DATA_DIR=/data
MEILI_ADDR=http://meilisearch:7700
MEILI_MASTER_KEY=REPLACE_ME
NEXTAUTH_URL=http://192.168.1.2:3000
NEXTAUTH_SECRET=REPLACE_ME
