[Unit]
Description=Manager orchestration capacity agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=youruser
WorkingDirectory=$HOME/ai-gateway
EnvironmentFile=$HOME/.config/manager-capacity-agent.env
ExecStart=$HOME/.local/bin/uv run --project $HOME/ai-gateway python -m services.capacity_agent.app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
