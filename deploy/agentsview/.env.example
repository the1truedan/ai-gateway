# Copy to .env in this directory on Tower (root-owned, mode 600, matches the
# sibling tower-orchestration/.env convention). Never commit the real file.
AGENTSVIEW_DB_PASSWORD=replace-with-a-random-database-password

# AgentsView's own API bearer token (--require-auth) is generated on first
# boot into the AGENTSVIEW_DATA_DIR volume's config.toml — there is no env
# var for it. Retrieve it after first `up` with:
#   docker exec tower-agentsview cat /data/config.toml
# Needed only by browser/API clients hitting the web UI on :42100 — m4rv and
# mrgpu's `agentsview pg push` only need AGENTSVIEW_PG_URL (the Postgres
# connection string, built from AGENTSVIEW_DB_PASSWORD above), not this token.
