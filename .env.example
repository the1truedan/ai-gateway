# Copy to .env and fill in values
# XAI_API_KEY can be copied from ~/grokcode/.env.local (GROK_API_KEY)

# --- Multi-host docker (Mac M4 / PopOS / Unraid) ---
# Use ./scripts/docker/compose.sh instead of bare docker compose
# AI_GATEWAY_HOST_PROFILE=mac|linux   # auto-detected if unset
# DOCKER_DEFAULT_PLATFORM=linux/arm64 # set by config/hosts/*.env
# OLLAMA_HOST_IP=<nas-host-ip-alt>         # Linux/Unraid: host IP for Ollama (not Mac)
# TURBOQUANT_HOST_IP=<mac-client-ip-alt>     # optional; Mac-only TurboQuant today

LITELLM_MASTER_KEY=sk-generate-a-secure-random-key
LITELLM_SALT_KEY=generate-a-random-salt
# Postgres for Admin UI (compose service litellm-db; internal only)
# Login: http://localhost:4000/ui/login/  username=admin  password=$LITELLM_MASTER_KEY
# Set before first `compose up` (changing later needs volume reset or ALTER USER).
LITELLM_DB_PASSWORD=change-me-local-only
# NFS v4.2 export mounted by the host. Mac override: /Volumes/ai-data.
AI_SHARED_ROOT=/mnt/ai-data
AI_NFS_ADDR=<nas-host-ip>

# xAI / Grok (required for manager-grok-coding fallback)
XAI_API_KEY=xai-your-key-here

# OpenRouter (optional — needed for manager-big-context / manager-understand-audit)
OPENROUTER_API_KEY=sk-or-your-key-here

# Google AI Studio / Gemini (Google One on you@example.com)
# Create key: https://aistudio.google.com/apikey — restrict to Gemini API only
# Never commit the real key; PHI/caregiver content should stay local by default
GEMINI_API_KEY=
# Separate unbilled AI Studio project used by tier-gemini-free only.
GEMINI_FREE_API_KEY=

# Explicit paid cloud aliases (never automatic from role-auto)
OPENAI_API_KEY=
OPENAI_PAID_MODEL=
# Anthropic / Claude Messages API — used by manager-claude-paid (litellm_config.nas-host.yaml).
ANTHROPIC_API_KEY=
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_PAID_MODEL=
HF_TOKEN=
HF_PAID_MODEL=
CIVITAI_API_TOKEN=
DARKBLOOM_API_KEY=
DARKBLOOM_MODEL=
AKASHML_API_KEY=
AKASHML_API_BASE=
AKASHML_MODEL=
SALAD_API_KEY=
SALAD_API_BASE=
SALAD_MODEL=
XAI_PAID_MODEL=
GEMINI_PAID_MODEL=

# Optional remote GPU tiers (linux overlay only)
# VLLM_API_BASE=http://<gpu-host-ip-alt>:8000/v1
# TURBOQUANT_CUDA_API_BASE=http://<gpu-host-ip-alt>:8001/v1

# manager-vision-embed FastAPI (LiteLLM model manager-vision-embed + native /v1/features)
# VISION_EMBED_PORT=8791
# VISION_EMBED_BACKEND=numpy
# VISION_EMBED_HOST=127.0.0.1
# VISION_EMBED_API_BASE=http://host.docker.internal:8791/v1  # linux overlay / optional

# LM Studio Developer Server (Mac host :1234) — manager-mlx-fast / manager-lms-local / tier-local-mlx
# Create token: LM Studio → Developer → API tokens (or Server settings)
# LM_API_TOKEN=
# LMSTUDIO_API_BASE=http://host.docker.internal:1234/v1

# Ollama Cloud (manager-reasoning-cloud → glm-5.2:cloud etc.)
# Create key: https://ollama.com/settings/keys — some models need a paid plan
# OLLAMA_API_KEY=
# Host Ollama must be signed in / have key available for :cloud model routing

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Open WebUI — generate: openssl rand -hex 32
# Required for stable MCP OAuth tokens across container restarts
WEBUI_SECRET_KEY=generate-with-openssl-rand-hex-32

# --- Open WebUI history import (grokhistory + grokcode) ---
# Run: ./scripts/import/run_openwebui_import.sh --all
# Or:  docker compose --profile import run --rm openwebui-importer --all --apply
# OPENWEBUI_USER_ID=          # auto-read from webui.db if empty
# GROK_HISTORY_EXPORT=        # auto-detected under ~/Downloads/ttl
# GROK_HISTORY_EXPORT_DIR=    # mount root for docker import profile
# GROK_SESSIONS_DIR=          # default ~/.grok/sessions
# GROK_BUILD_CWD_FILTER=      # colon-separated cwd prefixes (ai-gateway + grokcode)
# GROK_BUILD_INCLUDE_TOOLS=0  # set 1 to include tool-call summaries in grokcode imports
# OPENWEBUI_APPLY_SQL=0       # set 1 to apply SQL to webui.db (backs up first)
# OPENWEBUI_IMPORT_USE_DOCKER=auto  # auto=native on Apple Silicon; 1=force upstream amd64 image

# --- Grok session hygiene (prevents context token bloat) ---
# python3 scripts/prune_grok_sessions.py --keep 1
# python3 scripts/prune_grok_sessions.py --dry-run

# --- Integration earmarks (MANAGER ranking → ai-gateway scope) ---
# config/integration_earmarks.json

# --- Hister (compose profile search) ---
# HISTER_SEMANTIC_SEARCH_ENABLE=true
# HISTER_EMBEDDING_ENDPOINT=http://host.docker.internal:11434/v1/embeddings
# HISTER_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
# HISTER_EMBEDDING_API_KEY=ollama
# Prefer LiteLLM manager-embed from inside compose network:
# HISTER_EMBEDDING_ENDPOINT=http://litellm:4000/v1/embeddings
# HISTER_EMBEDDING_MODEL=manager-embed
# HISTER_EMBEDDING_API_KEY=$LITELLM_MASTER_KEY

# --- Memory: botmem (life) + hippo (agent) — see config/clients/memory_map.md ---
# Hippo is host-side (npm i -g hippo-memory); not compose.

# --- Turnstone (optional compose profile: turnstone) ---
# Host UI/API port; 8090 avoids Open WebUI :8080 and SearxNG :8081.
TURNSTONE_PORT=8090
# Best-practice default lets the local-only orchestrator select gpu-host, mac-client,
# or nas-host. Select tier-nvidia-fast inside Turnstone for a hard gpu-host pin.
TURNSTONE_MODEL=manager-auto
TURNSTONE_NODE_ID=mac-client-turnstone
# Required by Turnstone stable; generate with: openssl rand -hex 32
TURNSTONE_JWT_SECRET=generate-with-openssl-rand-hex-32
# Optional external SearxNG endpoint; blank disables Turnstone web_search.
TURNSTONE_SEARXNG_URL=
# --- Botmem personal/life memory SoR (compose profile memory) ---
# See config/clients/memory_platform.md
# BOTMEM_POSTGRES_PASSWORD=change-me
# BOTMEM_APP_SECRET=change-me
# BOTMEM_JWT_ACCESS_SECRET=change-me
# BOTMEM_JWT_REFRESH_SECRET=change-me
# BOTMEM_OAUTH_JWT_SECRET=change-me
# BOTMEM_OLLAMA_BASE_URL=http://host.docker.internal:11434
# BOTMEM_OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe:latest
# BOTMEM_OLLAMA_TEXT_MODEL=qwen3.5:9b

# --- Obsidian MCP (host; OpenCode mcp-obsidian enabled:false until set) ---
# OBSIDIAN_API_KEY=   # Local REST API community plugin
# OBSIDIAN_HOST=127.0.0.1
# OBSIDIAN_PORT=27124

# --- Headroom upstreams (must stay on LiteLLM for local-first) ---
# OPENAI path is used by OWUI/pi/OpenCode. ANTHROPIC path is used by Claude Messages
# clients; if unset, Headroom defaults to https://api.anthropic.com (scary /readyz noise).
# HEADROOM_OPENAI_TARGET=http://litellm:4000/v1
# HEADROOM_ANTHROPIC_TARGET=http://litellm:4000
# HEADROOM_NO_SUBSCRIPTION_TRACKING=1

# --- Hybrid prompt I/O metrics (compose profile security) ---
# Keep scanner on across restarts: run prompt-io + set ENABLED=1
#   ./scripts/docker/compose.sh --profile security up -d --build prompt-io
# Join key: LiteLLM response header x-litellm-call-id (see config/security/README.md)
PROMPT_IO_ENABLED=1
PROMPT_IO_BASE=http://prompt-io:5050
PROMPT_IO_TIMEOUT=0.5
PROMPT_IO_BLOCK=0
# Optional full deadbits/vigil-llm forward:
# PROMPT_IO_VIGIL_UPSTREAM=http://host.docker.internal:5000
# Optional LLMTrace shadow proxy port (not default client path):
# LLMTRACE_PORT=8090
# LLMTRACE_UPSTREAM_URL=http://headroom:8787

# --- ctx agent-history search (host-side; optional) ---
# Run: ./scripts/ctx/setup_ctx_grok_plugin.sh
# CTX_DATA_ROOT=              # default ~/.local/share/ctx
