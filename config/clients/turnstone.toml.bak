# Copy to ~/.config/turnstone/config.toml (chmod 600) or pass --config.
# Uses production LiteLLM proxy in ~/ai-gateway (Docker :4000).
# Set OPENAI_API_KEY to LITELLM_MASTER_KEY from ~/ai-gateway/.env before launch.

[api]
base_url = "http://localhost:4000/v1"
# api_key is taken from OPENAI_API_KEY env when unset here

[model]
name = "manager-fast-turbo"
temperature = 0.2
context_window = 32768

[models.local-fast]
name = "manager-fast-turbo"
provider = "openai"
base_url = "http://localhost:4000/v1"
context_window = 32768

[models.local-fast-ollama]
name = "manager-fast-local"
provider = "openai"
base_url = "http://localhost:4000/v1"
context_window = 32768

[models.local-reason]
name = "manager-reasoning-local"
provider = "openai"
base_url = "http://localhost:4000/v1"
context_window = 32768

[models.cloud-reason]
name = "manager-reasoning-cloud"
provider = "openai"
base_url = "http://localhost:4000/v1"
context_window = 131072

[models.grok-coding]
name = "manager-grok-coding"
provider = "openai"
base_url = "http://localhost:4000/v1"
context_window = 256000

# Docker Turnstone nodes should use:
#   LLM_BASE_URL=http://host.docker.internal:4000/v1
# and remap SearxNG host port if TurboQuant orch uses :8081
#   SEARXNG_API_PORT=18081
