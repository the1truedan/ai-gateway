{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nas-host-headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NAS-HOST Headroom",
      "options": {
        "baseURL": "http://<nas-host-ip>:8787/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "role-auto": {"name": "Role: automatic local/free routing"},
        "role-execute": {"name": "Role: explicit local execution"},
        "role-phi-local": {"name": "Role: PHI local only"},
        "tier-codex-cloud": {"name": "Paid: Codex (explicit approval)"},
        "tier-mimo-cloud": {"name": "Paid: Xiaomi MiMo (explicit approval)"}
      }
    }
  },
  "model": "nas-host-headroom/role-auto"
}
