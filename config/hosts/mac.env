# M4 Mac Mini — Ollama + TurboQuant + LM Studio on host, containers via host.docker.internal
AI_GATEWAY_HOST_PROFILE=mac
AI_SHARED_ROOT=/Volumes/ai-data
AI_NFS_ADDR=<nas-host-ip>
DOCKER_DEFAULT_PLATFORM=linux/arm64
OLLAMA_API_BASE=http://host.docker.internal:11434
TURBOQUANT_ORCH_API_BASE=http://host.docker.internal:8081/v1
TURBOQUANT_CODER_API_BASE=http://host.docker.internal:8082/v1
LITELLM_CONFIG_FILE=litellm_config.yaml
# Cloud keys live in repo-root .env (GEMINI_API_KEY, XAI_API_KEY, OPENROUTER_API_KEY)
# LM Studio / MLX (Developer Server) — manager-mlx-fast | manager-lms-local | tier-local-mlx
# Host: lms server start  → http://127.0.0.1:1234  (scripts/start_lmstudio_server.sh)
# Token: LM_API_TOKEN in .env (LM Studio → Developer → API tokens)
LMSTUDIO_API_BASE=http://host.docker.internal:1234/v1
# Vision FEATURE FastAPI (manager-vision-embed) — LiteLLM openai/ route + native /v1/features
# Host: ./scripts/start_vision_embed.sh   → http://127.0.0.1:8791
# Compose: ./scripts/docker/compose.sh --profile vision up -d
# LiteLLM (mac): http://host.docker.internal:8791/v1
# VISION_EMBED_BACKEND=numpy|stub|external
# VISION_EMBED_PORT=8791
