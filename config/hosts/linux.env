# PopOS / Unraid amd64 — point at LAN host running Ollama (override OLLAMA_HOST_IP in .env)
AI_GATEWAY_HOST_PROFILE=linux
AI_SHARED_ROOT=/mnt/ai-data
AI_NFS_ADDR=<nas-host-ip>
DOCKER_DEFAULT_PLATFORM=linux/amd64
OLLAMA_API_BASE=http://${OLLAMA_HOST_IP:-host.docker.internal}:11434
TURBOQUANT_ORCH_API_BASE=http://${TURBOQUANT_HOST_IP:-host.docker.internal}:8081/v1
TURBOQUANT_CODER_API_BASE=http://${TURBOQUANT_HOST_IP:-host.docker.internal}:8082/v1
LITELLM_CONFIG_FILE=litellm_config.linux.merged.yaml
# Optional remote GPU tiers (PopOS 4060 Ti / Unraid P2000) — used by manager-fast-cuda / manager-heavy-cuda
# VLLM_API_BASE=http://<gpu-host-ip-alt>:8000/v1
# TURBOQUANT_CUDA_API_BASE=http://<gpu-host-ip-alt>:8001/v1
# Vision feature FastAPI for LiteLLM manager-vision-embed
VISION_EMBED_API_BASE=http://${VISION_EMBED_HOST_IP:-host.docker.internal}:8791/v1
# Cloud keys: GEMINI_API_KEY, XAI_API_KEY, OPENROUTER_API_KEY in repo-root .env
