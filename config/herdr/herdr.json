{
  "enabled": true,
  "binary": "herdr",
  "session": null,
  "socket_path": null,
  "workspace_cwd": "$HOME/ai-gateway",
  "workspace_label": "ai-gateway",
  "use_python_client": false,
  "layout_file": "config/herdr/layout.json",
  "default_panes": [
    "stack",
    "usage",
    "health",
    "agent",
    "grok"
  ],
  "inference_base_url": "http://localhost:8787/v1",
  "inference_bypass_url": "http://localhost:4000/v1",
  "preferred_model": "manager-code",
  "recommended_model": "manager-code",
  "gpu_host_base_url": "http://<gpu-host-ip>:8787/v1",
  "gpu_host_accelerated_models": [
    "manager-code",
    "manager-reason",
    "manager-worker-mrgpu-code"
  ],
  "non_phi_cloud_option": "manager-openrouter-free",
  "orchestration_roles": {
    "plan": "manager-plan",
    "execute": "manager-code",
    "recon": "manager-research",
    "phi": "manager-phi-local",
    "reason": "manager-reason",
    "audit": "manager-review",
    "note": "Use manager-* only (role-*/tier-* are dead 404). Coding pins manager-code \u2192 mrgpu qwen3.5:9b via Headroom. Never embed Admin UI dashboard keys."
  },
  "install_hint": "brew install herdr  # or: curl -fsSL https://herdr.dev/install.sh | sh",
  "license_note": "AGPL-3.0 \u2014 local agent multiplexer only; not a model gateway",
  "architecture": {
    "agent_head": "herdr",
    "token_conservation": "headroom :8787",
    "inference_head": "litellm :4000",
    "chat_surface": "open-webui \u2192 headroom \u2192 litellm",
    "spend_ui": "litellm admin ui :4000/ui",
    "mobile_ui": "collie (optional, Tailscale serve only)"
  }
}
